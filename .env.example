# mysite Compose 非秘密設定範例（實際檔案由 scripts/cloud/bootstrap.sh 產生於 .runtime/env/<環境>.env）。
# 這裡沒有任何秘密；秘密一律以 *_FILE 指向 .runtime/secrets/<環境>/（開發）或主機受限目錄（正式）。
# 每個鍵的用途、預設與檢查見 docs/設定目錄.md。

# ---- 環境 ----
MYSITE_ENVIRONMENT=development
WP_ENVIRONMENT_TYPE=development
APP_DEBUG=true
LOG_LEVEL=debug

# ---- 網址（瀏覽器使用；主站與 CMS 分開） ----
APP_URL=http://127.0.0.1:8080
WP_PUBLIC_URL=http://127.0.0.1:8081
APP_HOST=_
CMS_HOST=_
APP_PORT=8080
CMS_PORT=8081

# ---- 語系與時區 ----
APP_LOCALE=zh_TW
APP_TIMEZONE=Asia/Taipei

# ---- 內容整合（容器內固定來源） ----
CONTENT_API_BASE_URL=http://wp-web:8080/wp-json/site-content/v1
CONTENT_PRIVATE_API_BASE_URL=https://wp-web:8443/wp-json/site-content/v1
CONTENT_EVENT_URL=http://app-web:8080/internal/content-events/v1
CONTENT_EVENT_KEY_ID=k1
CONTENT_SERVICE_USERNAME=mysite-service
CONTENT_CONNECT_TIMEOUT_SECONDS=2
CONTENT_HTTP_TIMEOUT_SECONDS=5
CONTENT_VISIBILITY_TTL_SECONDS=30
CONTENT_BODY_CACHE_TTL_SECONDS=300
PREVIEW_TTL_SECONDS=600
PODCAST_AUDIO_ALLOWED_HOSTS=

# ---- 商務（disabled｜simulation；real 一律拒絕） ----
COMMERCE_MODE=disabled
SIMULATION_DATA_RETENTION_DAYS=30
CART_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90

# ---- Session／郵件 ----
SESSION_SECURE_COOKIE=false
MAIL_MAILER=log

# ---- 資料庫名稱與帳號（密碼在秘密檔） ----
WP_DB_NAME=mysite_wp
WP_DB_USER=mysite_wp
APP_DB_NAME=mysite_app
APP_DB_USER=mysite_app
APP_TEST_DB_NAME=mysite_app_test

# ---- 網路（容器子網；gateway 位於 edge） ----
EDGE_SUBNET=172.30.10.0/24
BACKEND_SUBNET=172.30.20.0/24
DB_SUBNET=172.30.30.0/24

# ---- 部署（只在 staging／production 由簽章清單提供） ----
DEPLOY_ENVIRONMENT=
DEPLOY_CHANNEL=
RELEASE_ID=unreleased
MYSITE_HSTS_HEADER=
