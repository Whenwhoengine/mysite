# Laravel 不在容器內使用 .env：所有設定由 Compose 環境變數注入、秘密由 *_FILE 讀取（ADR-006）。
# 本檔只列出鍵名供參考，完整說明見 ../docs/設定目錄.md 與 ../.env.example。
APP_ENV=development
APP_DEBUG=true
APP_URL=http://mysite.localhost:8080
APP_KEY_FILE=/run/secrets/app_key
APP_LOCALE=zh_TW
APP_TIMEZONE=Asia/Taipei
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=mysite_app
DB_USERNAME=mysite_app
DB_PASSWORD_FILE=/run/secrets/app_db_password
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
COMMERCE_MODE=disabled
