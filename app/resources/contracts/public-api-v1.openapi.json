{
  "openapi": "3.0.3",
  "info": {
    "title": "mysite 公開唯讀 API",
    "version": "1.0.0",
    "description": "MySite React 前端專案 F1 定稿（docs/MySiteReact前端專案v1.md §5、定案執行書 M-18）。只有 GET；回應不帶 Set-Cookie、一律 Cache-Control: no-store；只回公開內容與畫面需要的欄位；時間一律 UTC。破壞性變更須另開 /api/v2。說明見 docs/公開API契約.md；本檔正本位置 app/resources/contracts/public-api-v1.openapi.json。"
  },
  "servers": [
    {
      "url": "/",
      "description": "app-web（只供前端容器經專用網路呼叫；gateway 對外 /api/ 回 404）"
    }
  ],
  "paths": {
    "/api/v1/site": {
      "get": {
        "operationId": "getSite",
        "summary": "網站資訊與選單",
        "description": "WordPress 讀不到時沿用內建後備（fallback 為 true），不回 503；只有 Laravel 維護模式（換版）時回 503（HTTP_503）。",
        "responses": {
          "200": {
            "description": "網站資訊",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "一律 no-store",
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "Laravel 維護模式（HTTP_503）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/home": {
      "get": {
        "operationId": "getHome",
        "summary": "首頁區塊",
        "responses": {
          "200": {
            "description": "首頁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "一律 no-store",
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                }
              }
            }
          },
          "503": {
            "description": "WordPress 失聯、逾時、5xx、格式不符，或可見性證明過期且無法重新確認（CONTENT_UPSTREAM_UNAVAILABLE、CONTENT_MODEL_UNSUPPORTED）；絕不回舊正文",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/articles": {
      "get": {
        "operationId": "list_articles",
        "summary": "文章列表（每頁 12）",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1～1000 的正整數（^[1-9]\\d{0,3}$）；其他值與超過總頁數一律 404",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "一律 no-store",
                "schema": {
                  "type": "string",
                  "pattern": "no-store"
                }
              }
            }
          },
          "404": {
            "description": "找不到（CONTENT_NOT_FOUND）：內容不存在、不公開、slug 或 page 不合法、page 超過總頁數",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "WordPress 失聯、逾時、5xx、格式不符，或可見性證明過期且無法重新確認（CONTENT_UPSTREAM_UNAVAILABLE、CONTENT_MODEL_UNSUPPORTED）；絕不回舊正文",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
