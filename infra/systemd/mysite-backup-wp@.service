# mysite：WordPress DB＋uploads（每日） 加密備份到 restic repository（v5 第 15 章，OPS-07）。
[Unit]
Description=mysite 備份 WordPress DB＋uploads（每日）（%i）
Documentation=file:///srv/mysite/platform/docs/runbooks/備份與還原.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/srv/mysite/environments/%i/secrets/restic_repository

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /srv/mysite/platform/scripts/ops/backup.sh --env=%i --reason=routine --scope=wp
# 暫定：單次備份上限 3 小時
TimeoutStartSec=3h
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
