# mysite：每週完整性檢查（v5 §15.2「每週完整性檢查」）：做一次 scope=all 備份並以 restic check --read-data-subset 抽樣讀回。
[Unit]
Description=mysite 每週備份完整性檢查（%i）
Documentation=file:///srv/mysite/platform/docs/runbooks/備份與還原.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/srv/mysite/environments/%i/secrets/restic_repository

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /srv/mysite/platform/scripts/ops/backup.sh --env=%i --reason=weekly-check --scope=all --verify=deep
TimeoutStartSec=4h
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
Nice=10
