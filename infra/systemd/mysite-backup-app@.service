# mysite：Laravel DB＋刪除紀錄（每小時） 加密備份到 restic repository（v5 第 15 章，OPS-07）。
[Unit]
Description=mysite 備份 Laravel DB＋刪除紀錄（每小時）（%i）
Documentation=https://github.com/Whenwhoengine/mysite/blob/main/docs/runbooks/%%E5%%82%%99%%E4%%BB%%BD%%E8%%88%%87%%E9%%82%%84%%E5%%8E%%9F.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/srv/mysite/environments/%i/secrets/restic_repository

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /srv/mysite/platform/scripts/ops/backup.sh --env=%i --reason=routine --scope=app
# 暫定：單次備份上限 3 小時
TimeoutStartSec=3h
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
