# gateway（development／testing）：只在容器埠 8080／8081 提供 HTTP，Compose 只綁 127.0.0.1。
# 主站：${APP_PUBLIC_PORT_INTERNAL:-8080} → app-web；CMS：8081 → wp-web:8081
log_format mysite_json escape=json '{"timestamp":"$time_iso8601","service":"gateway","environment":"${MYSITE_ENVIRONMENT}","level":"info","event":"http_access","request_id":"$request_id","status":$status,"method":"$request_method","path":"$uri","bytes":$body_bytes_sent,"duration":$request_time,"upstream":"$upstream_addr"}';
access_log /dev/stdout mysite_json;

map $http_x_forwarded_proto $mysite_scheme { default $scheme; }

limit_req_zone $binary_remote_addr zone=mysite_login:10m rate=10r/m;
limit_req_status 429;

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;
    client_max_body_size 2m;
    location = /login { limit_req zone=mysite_login burst=10 nodelay; include /etc/nginx/snippets/gateway-proxy.conf; proxy_pass http://app-web:8080; }
    location / { include /etc/nginx/snippets/gateway-proxy.conf; proxy_pass http://app-web:8080; }
}

server {
    listen 8081;
    server_name _;
    server_tokens off;
    client_max_body_size 34m;
    location = /wp-login.php { limit_req zone=mysite_login burst=10 nodelay; include /etc/nginx/snippets/gateway-proxy.conf; proxy_pass http://wp-web:8081; }
    location / { include /etc/nginx/snippets/gateway-proxy.conf; proxy_pass http://wp-web:8081; }
}
