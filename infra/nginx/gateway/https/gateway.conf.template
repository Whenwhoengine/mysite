# gateway（staging／production）：80 只做 ACME 與轉 HTTPS；443 依 host 路由。
# HSTS 預設關閉，於正式子網域與 HTTPS 行為確認後以 MYSITE_HSTS_HEADER 開啟（v5 §13.6-7）。
# 上游容器重建後 IP 會改變：一律經 Docker 內建 DNS 動態解析（避免把流量送到重新分配同一 IP 的其他服務）
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

log_format mysite_json escape=json '{"timestamp":"$time_iso8601","service":"gateway","environment":"${MYSITE_ENVIRONMENT}","level":"info","event":"http_access","request_id":"$request_id","status":$status,"method":"$request_method","host":"$host","path":"$uri","bytes":$body_bytes_sent,"duration":$request_time}';
# access_log 設在各 server 區塊（覆寫 nginx.conf 預設含查詢字串的 main 格式）
map $http_x_forwarded_proto $mysite_scheme { default "https"; }
# 登入限流只計「送出登入」（POST）；開啟登入頁（GET）不計。速率可由 MYSITE_LOGIN_RATE 設定（正式預設 10r/m）
map $request_method $mysite_login_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $mysite_login_limit_key zone=mysite_login:10m rate=${MYSITE_LOGIN_RATE};
limit_req_status 429;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    access_log /dev/stdout mysite_json;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; default_type text/plain; try_files $uri =404; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_HOST};
    server_tokens off;
    access_log /dev/stdout mysite_json;
    ssl_certificate /etc/mysite-tls/live/${APP_HOST}/fullchain.pem;
    ssl_certificate_key /etc/mysite-tls/live/${APP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:mysite_tls:10m;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "${MYSITE_HSTS_HEADER}" always;
    # 後臺登入相關（Fortify prefix=admin）：只計 POST，與 Laravel 自身的 email＋IP 限流並行。
    # Laravel 比對路由前會去掉結尾斜線（/admin/login/ 仍進同一處理程式），所以結尾斜線一併納入；
    # 連續斜線、%XX、. 與 .. 由 nginx 正規化（merge_slashes 預設 on）後才比對，不需另列。
    location ~ ^/admin/(login|two-factor-challenge|forgot-password|reset-password)/?$ { limit_req zone=mysite_login burst=10 nodelay; include /etc/nginx/snippets/gateway-proxy.conf; set $mysite_app_upstream http://app-web:8080; proxy_pass $mysite_app_upstream; }
    # /index.php/<路徑> 會被 Laravel 當成 <路徑>（前端控制器別名，例如 /index.php/admin/login 進入登入處理程式），
    # 可繞過本區塊所有以路徑為準的規則（登入限流、/internal/ 阻擋）。正常網址不會出現此前綴，一律 404。
    location ^~ /index.php/ { return 404; }
    # 只放行受權杖保護的部署狀態端點；其他 /internal/* 一律 404（v5 §14.8）
    location = /internal/deploy-status { include /etc/nginx/snippets/gateway-proxy.conf; set $mysite_app_upstream http://app-web:8080; proxy_pass $mysite_app_upstream; }
    location ^~ /internal/ { return 404; }
    location / { include /etc/nginx/snippets/gateway-proxy.conf; set $mysite_app_upstream http://app-web:8080; proxy_pass $mysite_app_upstream; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CMS_HOST};
    server_tokens off;
    access_log /dev/stdout mysite_json;
    ssl_certificate /etc/mysite-tls/live/${CMS_HOST}/fullchain.pem;
    ssl_certificate_key /etc/mysite-tls/live/${CMS_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:mysite_tls:10m;
    client_max_body_size 34m;
    add_header Strict-Transport-Security "${MYSITE_HSTS_HEADER}" always;
    location = /wp-login.php { limit_req zone=mysite_login burst=10 nodelay; include /etc/nginx/snippets/gateway-proxy.conf; set $mysite_cms_upstream http://wp-web:8081; proxy_pass $mysite_cms_upstream; }
    location / { include /etc/nginx/snippets/gateway-proxy.conf; set $mysite_cms_upstream http://wp-web:8081; proxy_pass $mysite_cms_upstream; }
}
