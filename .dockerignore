# 映像建置排除：秘密、執行期資料、Git、測試報告、相依目錄（映像內另行依 lockfile 安裝）
.git
.github
.claude
.runtime
**/.env
**/.env.*
!**/.env.example
**/secrets
**/*.pem
**/*.key
**/*.sql
**/*.sql.gz
**/*.dump
**/*.zip
**/node_modules
app/vendor
app/storage/logs/*
app/storage/framework/sessions/*
app/storage/framework/cache/*
app/storage/framework/views/*
app/bootstrap/cache/*.php
app/public/build
app/public/hot
app/coverage
app/.phpunit.cache
wp/core
wp/uploads
docs
tests/e2e/test-results
tests/e2e/playwright-report
**/*.log
